rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * =====================================================================
     *                          DOCUMENTATION
     * =====================================================================
     *
     * Core Philosophy:
     * This ruleset is currently configured for a single-user prototype
     * environment. The helper functions `isMemberOfOrg` and `isAdmin` are set
     * to only require authentication, which grants any signed-in user broad
     * read/write access for development purposes.
     *
     * For a production multi-tenant application, these functions MUST be
     * updated to inspect Firebase Authentication Custom Claims (`orgId`, `role`)
     * to enforce true data segregation and role-based access control.
     *
     */

    // =====================================================================
    //                         HELPER FUNCTIONS
    // =====================================================================

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * PROTOTYPE-ONLY-RULE: Grants access if the user is signed in.
     * In a real multi-tenant app, this would check for organization membership via custom claims:
     * `return isSignedIn() && request.auth.token.orgId == orgId;`
     */
    function isMemberOfOrg(orgId) {
      return isSignedIn();
    }

    /**
     * PROTOTYPE-ONLY-RULE: Grants admin rights if the user is signed in.
     * In a real multi-tenant app, this would check for an admin role claim:
     * `return isMemberOfOrg(orgId) && request.auth.token.role == 'admin';`
     */
    function isAdmin(orgId) {
      return isSignedIn();
    }

    /**
     * Determines if a user has read access to organization data.
     * Inherits logic from `isMemberOfOrg`.
     */
    function canRead(orgId) {
      return isMemberOfOrg(orgId);
    }

    /**
     * Determines if a user has write access to organization data.
     * Inherits logic from `isAdmin`.
     */
    function canWrite(orgId) {
      return isAdmin(orgId);
    }

    /**
     * Checks if the authenticated user's UID matches the given userId.
     * Used to verify resource ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Validates that the `organizationId` field in a new document matches
     * the organizationId from the path. Enforces relational integrity on create.
     */
    function isCreatingWithValidOrgId(orgId) {
      return request.resource.data.organizationId == orgId;
    }

    /**
     * Validates that the `organizationId` field is immutable on update.
     * Prevents re-assigning a document to a different organization.
     */
    function isOrgIdImmutable() {
      return request.resource.data.organizationId == resource.data.organizationId;
    }

    // =====================================================================
    //                         COLLECTION RULES
    // =====================================================================

    /**
     * @description Controls access to top-level Organization documents.
     * @path /organizations/{organizationId}
     * @allow (get) An authenticated user can read their own organization's document.
     * @deny (create, update, delete) All client-side mutations are disallowed. Organization lifecycle is managed by the backend.
     * @deny (list) Listing all organizations is disallowed for security.
     * @principle Restricts top-level collection modifications to trusted backend processes.
     */
    match /organizations/{organizationId} {
      allow get: if canRead(organizationId);
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to User profiles within an organization.
     * @path /organizations/{organizationId}/users/{userId}
     * @allow (create) An authenticated user can create their own user profile document.
     * @allow (get, update) A user can get/update their own profile. An admin can get/update any profile in their organization.
     * @allow (list, delete) Only admins can list or delete users within their organization.
     * @deny A user cannot access another user's profile (unless they are an admin).
     * @principle Enforces a combination of user self-service and administrative oversight.
     */
    match /organizations/{organizationId}/users/{userId} {
      allow get: if isMemberOfOrg(organizationId) && (isAdmin(organizationId) || isOwner(userId));
      allow list: if isAdmin(organizationId);
      allow create: if isOwner(userId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && isMemberOfOrg(organizationId) && (isAdmin(organizationId) || isOwner(userId)) && isOrgIdImmutable();
      allow delete: if resource != null && isAdmin(organizationId);
    }

    /**
     * @description Secures the singleton configuration document for an organization.
     * @path /organizations/{organizationId}/configuration/{docId}
     * @allow (get) Any member of the organization can read the configuration.
     * @allow (create, update, delete) Only admins of the organization can modify the configuration.
     * @deny (list) Listing is not applicable as this path should only contain one document.
     * @principle Provides read-only access for members and write access for administrators.
     */
    match /organizations/{organizationId}/configuration/{docId} {
      allow get: if canRead(organizationId);
      allow list: if false;
      allow create: if canWrite(organizationId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && canWrite(organizationId) && isOrgIdImmutable();
      allow delete: if resource != null && canWrite(organizationId);
    }

    /**
     * @description Generic rule for organization-level read-only/admin-write collections.
     * @path /organizations/{organizationId}/contextDocuments/{documentId}
     * @path /organizations/{organizationId}/agents/{agentId}
     * @path /organizations/{organizationId}/conversations/{conversationId}
     * @path /organizations/{organizationId}/insights/{insightId}
     * @path /organizations/{organizationId}/kpiDefinitions/{kpiDefinitionId}
     * @path /organizations/{organizationId}/kpiValues/{kpiValueId}
     * @allow (get, list) Any member of the organization can read data.
     * @allow (create, update, delete) Only admins of the organization can write data.
     * @deny A non-member cannot access any data. A non-admin cannot write data.
     * @principle Establishes a standard organization-wide security posture: read for all members, write for admins.
     */
    match /organizations/{organizationId}/contextDocuments/{docId} {
      allow get, list: if canRead(organizationId);
      allow create: if canWrite(organizationId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && canWrite(organizationId) && isOrgIdImmutable();
      allow delete: if resource != null && canWrite(organizationId);
    }
    match /organizations/{organizationId}/agents/{docId} {
      allow get, list: if canRead(organizationId);
      allow create: if canWrite(organizationId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && canWrite(organizationId) && isOrgIdImmutable();
      allow delete: if resource != null && canWrite(organizationId);
    }
    match /organizations/{organizationId}/conversations/{docId} {
      allow get, list: if canRead(organizationId);
      allow create: if canWrite(organizationId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && canWrite(organizationId) && isOrgIdImmutable();
      allow delete: if resource != null && canWrite(organizationId);
    }
    match /organizations/{organizationId}/insights/{docId} {
      allow get, list: if canRead(organizationId);
      allow create: if canWrite(organizationId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && canWrite(organizationId) && isOrgIdImmutable();
      allow delete: if resource != null && canWrite(organizationId);
    }
    match /organizations/{organizationId}/kpiDefinitions/{docId} {
      allow get, list: if canRead(organizationId);
      allow create: if canWrite(organizationId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && canWrite(organizationId) && isOrgIdImmutable();
      allow delete: if resource != null && canWrite(organizationId);
    }
    match /organizations/{organizationId}/kpiValues/{docId} {
      allow get, list: if canRead(organizationId);
      allow create: if canWrite(organizationId) && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && canWrite(organizationId) && isOrgIdImmutable();
      allow delete: if resource != null && canWrite(organizationId);
    }

    /**
     * @description Secures Report Definitions, which are user-owned within an organization.
     * @path /organizations/{organizationId}/reportDefinitions/{reportDefinitionId}
     * @allow (create) Any member of an organization can create a report definition for themselves.
     * @allow (update, delete) The user who owns the report or an organization admin can modify or delete it.
     * @allow (get, list) All members of the organization can read all report definitions.
     * @deny A user cannot modify another user's report definition unless they are an admin.
     * @principle Combines organization-wide read access with user-specific ownership for writes.
     */
    match /organizations/{organizationId}/reportDefinitions/{reportDefinitionId} {
      allow get, list: if canRead(organizationId);
      allow create: if isMemberOfOrg(organizationId) && request.resource.data.userId == request.auth.uid && isCreatingWithValidOrgId(organizationId);
      allow update: if resource != null && isMemberOfOrg(organizationId) && (isAdmin(organizationId) || isOwner(resource.data.userId)) && isOrgIdImmutable() && request.resource.data.userId == resource.data.userId;
      allow delete: if resource != null && isMemberOfOrg(organizationId) && (isAdmin(organizationId) || isOwner(resource.data.userId));
    }

    /**
     * @description Secures the singleton analysis result document for a conversation.
     *              The analysis result is now a single document containing all nested data.
     * @path /organizations/{organizationId}/conversations/{conversationId}/analysisResult/{docId}
     * @allow (get) Any member of the organization can read the analysis result.
     * @allow (create, update, delete) Only admins of the organization can modify the result.
     * @deny (list) Listing is not applicable as this is a single-document path.
     * @principle Provides read-only access for members and write access for administrators.
     */
    match /organizations/{organizationId}/conversations/{conversationId}/analysisResult/{docId} {
      allow get: if canRead(organizationId);
      allow list: if false;
      allow create: if canWrite(organizationId);
      allow update: if resource != null && canWrite(organizationId);
      allow delete: if resource != null && canWrite(organizationId);
    }

  }
}
